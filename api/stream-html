@app.post("/api/stream-html")
async def stream_html_updates():
    async def event_generator():
        # Stream raw HTML blocks directly to client
        yield "data: <div class='badge bg-blue'>Status: Analyzing Vectors</div>\n\n"
        await asyncio.sleep(0.2)
        
        yield "data: <div id='score-card' class='card alert-red'>Refusal Prob: 92%</div>\n\n"
    
    return StreamingResponse(event_generator(), media_type="text/event-stream")